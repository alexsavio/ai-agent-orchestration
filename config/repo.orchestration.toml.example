# Repo settings. Commit this as .orchestration.toml at the repo root; personal overrides go in
# .orchestration.local.toml next to it (git-ignored). An exported ORCH_* variable wins over both.

[guard]
# Broad Git reads (git grep, cat-file over all objects) are blocked in this repo
big_repo = false

[audit]
# Check names that only run on a full CI run; an approved PR on a non-default base reports "full CI ran" or "full CI not run"
merge_gate_checks = []

[legacy]
# Open PRs of this repo are scanned for added lines that legacy.rules count (LEGACY line)
scan = false
# Path globs no legacy rule counts
exempt = []

[focus]
# Case-insensitive regex matched against the labels of the workers of an architect working in this repo; empty turns the focus check off
pattern = ""
# Architect name never listed as lacking a focus worker
architect = ""

# Legacy rules ([[legacy.rules]]): the tool ships none. The first rule whose paths cover a file and whose
# pattern matches a line names the line's kind; a rule without a pattern counts every line it covers.
# Example for a Rails app moving off jQuery:
#
# [[legacy.rules]]
# kind = "JSERB"
# paths = ["**/*.js.erb"]
#
# [[legacy.rules]]
# kind = "LEGACY"
# paths = ["app/assets/javascripts/**"]
#
# [[legacy.rules]]
# kind = "JQUERY"
# pattern = '\$\(|jQuery|rails-ujs|data-remote|remote: *true'
# paths = ["**/*.{js,coffee,erb,rb}"]
# exclude = ["spec/**"]
