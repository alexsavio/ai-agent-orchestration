# Settings for the Coordinator / architect setup. install.sh copies this file to
# ~/.claude/orchestration.env on the first run only and never overwrites it. It is sourced by bash,
# so use plain KEY="value" lines. A variable exported in the environment wins over this file.
# Override the file location with ORCH_CONFIG=/path/to/file.

# --- Required by coord-audit-watch.sh (it exits with an error when either is empty) ---
# GitHub repos whose PRs the audit watches, space separated: owner/name owner/name
ORCH_PR_REPOS=""
# GitHub login whose open PRs the audit watches ("@me" works too)
ORCH_PR_AUTHOR=""

# --- Optional: audit ---
# Only PRs updated on or after this date (YYYY-MM-DD). Empty = no date filter.
ORCH_PR_SINCE=""
# Check names that only run on a full CI run, separated by "|". An approved PR whose base is not
# the repo's default branch is reported with "full CI ran" or "full CI not run". Empty = no CI note.
ORCH_MERGE_GATE_CHECKS=""
# Login of the review bot whose "Needs a closer look" review body raises a COPILOT line.
ORCH_BOT_REVIEWER_LOGIN="copilot-pull-request-reviewer"
# Local clones to watch for pack and worktree pile-ups, space separated paths. Empty = skip.
ORCH_GIT_WATCH_REPOS=""
ORCH_PACKS_MAX="50"
ORCH_WORKTREES_MAX="40"
# Page sizes of the GitHub query. PR search is paged; larger nested connections print a TRUNCATED line.
ORCH_AUDIT_PAGE_PRS="80"
ORCH_AUDIT_PAGE_NODES="100"
# Repos whose open PRs get a LEGACY line (lines added that build on jQuery, .js.erb or asset-pipeline JS), space separated.
# Repos to scan for legacy code; empty disables scans. Example: "acme/webapp".
ORCH_LEGACY_REPOS=""
# Regex alternation appended to the built-in jQuery/ujs patterns, for project names such as "old-widget|legacy-grid". Empty = built-in only.
ORCH_LEGACY_EXTRA_PATTERN=""
# Space-separated repo paths the built-in scan skips, added to the two ratchet guard files under scripts/. Empty = those two only.
ORCH_LEGACY_EXEMPT_PATHS=""
# PRs scanned per audit pass; the rest wait for the next pass.
ORCH_LEGACY_SCANS_MAX="10"
# File reads per PR scan for files GitHub returns without a patch; more fails the scan.
ORCH_LEGACY_READS_MAX="20"

# --- Heavy-job slots ---
# Maximum simultaneous heavy child processes on this machine.
ORCH_HEAVY_SLOTS_MAX="4"
# Architect names excluded from focus reporting, comma separated. Empty = include all.
ORCH_FOCUS_SKIP_ARCHITECTS=""
# Case-insensitive regex matched against worker workspace labels. The FOCUS line counts matches and lists architects with none. Empty = off.
ORCH_FOCUS_PATTERN=""
# Architect name never listed as lacking a focus worker. Empty = none exempt.
ORCH_FOCUS_ARCHITECT=""

# --- Models. The skills read these; change them to models your accounts can use ---
ORCH_COORDINATOR_MODEL="claude-opus-5-5"
ORCH_ARCHITECT_MODEL="claude-opus-5-5"
ORCH_CODEX_WORKER_MODEL="<codex-worker-model>"
ORCH_CODEX_SMART_MODEL="<codex-smart-model>"

# --- Context recycle ---
# A session is recycled when its token sensor reaches this count.
ORCH_RECYCLE_TOKENS="300000"
# Fallback percentage when a session has no token sensor.
ORCH_RECYCLE_PCT="55"
# Opt in to parking architects with no open PR, running worker, or watcher.
ORCH_PARK_IDLE="0"

# --- install.sh ---
# The clone install.sh keeps up to date and links into ~/.claude. Empty = ~/.claude/ai-agent-orchestration.
ORCH_REPO_PATH=""
# Env adapter install.sh runs without --env (a directory name under env/, e.g. herdr; "none" skips).
# Empty = herdr.
ORCH_ENV=""

# --- Optional: Herdr Radar checkout (draws the architect -> worker tree). ---
# The herdr env checks out env/herdr/radar.pin here. Empty = ~/.claude/herdr-radar.
ORCH_RADAR_PATH=""

# --- Optional: watcher services (macOS launchd, Linux systemd --user). Off by default. ---
# "1" = install.sh renders this platform's templates beside their links in ~/.claude and registers every
# watcher to run now and at login (macOS: a copy in ~/Library/LaunchAgents; Linux: systemctl --user enable --now).
# Back to "0" stops and removes them.
# Needs ORCH_HERDR_BIN and ORCH_HERDR_SOCKET set (see the coordinator section).
ORCH_WATCHERS_SERVICE="0"

# --- Optional: user to-do watcher paths. Empty uses ~/.claude/coordinator/{status,user-todo.md,user-todo.state.json}. ---
ORCH_USER_TODO_STATUS_DIR=""
ORCH_USER_TODO_OUTPUT=""
ORCH_USER_TODO_STATE=""

# --- Optional: daily legacy map (configured projects). Needs ORCH_WATCHERS_SERVICE="1". ---
# Path of the project clone. Renders and registers a daily job that writes ~/.claude/coordinator/legacy-map.tsv
# from origin/main. Empty = the ORCH_GIT_WATCH_REPOS clone named like an ORCH_LEGACY_REPOS repo. With no such
# clone, or with ORCH_LEGACY_REPOS="", there is no job. Needs rg on ORCH_PATH.
ORCH_LEGACY_MAP_REPO=""

# --- Optional: host watcher thresholds (macOS and Linux) ---
ORCH_HOST_PRESSURE_MIN_PCT="20"
ORCH_HOST_SWAP_MAX_MB="1024"
ORCH_HOST_PROCS_MAX="1300"
ORCH_HOST_FILES_MAX="150000"
ORCH_HOST_LOAD_MAX="40"
# The host watcher stores dedupe state under its required --state-dir.

# --- Optional: feed delivery of watcher alerts (notify-inbox.py --deliver file) ---
# Every alert stays in the alert files. The feed gets one start line and one clear line per condition.
# Severity steps grow by this ratio from each threshold (lower is worse for free memory); greater than 1.
# A HOST metric in its second severity step (ratio x threshold; free memory: threshold / ratio) writes its own danger line once.
ORCH_ALERT_ESCALATE_RATIO="1.5"
# Seconds between digest lines; a digest is written only when something was folded.
ORCH_ALERT_DIGEST_S="1800"
# Seconds a host, balance, hog or read-failure condition must stay clear before its clear line; a return
# inside this hold continues the condition.
ORCH_ALERT_QUIET_S="1800"

# --- Optional: coord-hog-watch.sh thresholds ---
ORCH_HOG_GB="6"
ORCH_HOG_GIT_GB="2"
ORCH_HOG_GIT_AGE_S="180"

# --- coordinator ---
# Python interpreter for coordinator/watchers shell wrappers and generated service templates.
ORCH_PYTHON3="python3"
# GitHub search scope (for example, "org:your-org") used by coordinator/watchers PR watchers.
ORCH_WATCHERS_PR_SCOPE=""
# Model label included in watcher dispatch records; empty leaves it unspecified.
ORCH_WATCHERS_WORKER_MODEL=""
# Repository treated as the primary product in watcher dispatch records, in owner/name form.
ORCH_WATCHERS_PRIMARY_REPO=""
# Absolute path to Herdr's executable for generated watcher service templates.
ORCH_HERDR_BIN=""
# Absolute path to Herdr's socket for generated watcher service templates.
ORCH_HERDR_SOCKET=""
# PATH supplied to generated watcher service templates.
ORCH_PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Big-repo read guard remote list; empty disables it. Example: "acme/webapp".
ORCH_BIG_REPO_REMOTES=""
# PR-tabs organization; empty disables org tab actions. Example: "acme".
ORCH_PR_TABS_ORG=""
# PR-tabs repo for bare numbers; empty disables number jumps. Example: "webapp" (acme/webapp).
ORCH_PR_TABS_DEFAULT_REPO=""

# PR-tabs open-all search; empty disables it. Example: "is:pr is:open author:dev org:acme sort:updated-desc".
ORCH_PR_TABS_OPEN_ALL=""

# PR-tabs topic regex rules as JSON; empty disables custom topics. Example for acme/webapp: '[{"name":"Webapp","color":"blue","repo":["^webapp$"]}]'.
ORCH_PR_TABS_TOPICS=""
