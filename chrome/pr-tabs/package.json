{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "imports": {
    "#/*": "./src/*",
    "#popup/*": "./src/popup/*",
    "#test/*": "./test/*",
    "#build/*": "./build/*"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --maxWorkers=1",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@primeuix/themes": "2.0.3",
    "@vueuse/core": "15.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@primevue/core": "4.5.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.6",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
