#!/usr/bin/env python3
"""One line per Herdr agent: name, pane, status, workspace, owner, role, cwd. Replaces the ~10k-token `herdr agent list` JSON."""
import json
import os
import subprocess
import sys
from pathlib import Path


def herdr(*args):
    binary = os.environ.get('HERDR_BIN_PATH') or os.environ.get('ORCH_HERDR_BIN') or 'herdr'
    out = subprocess.run([binary, *args], capture_output=True, text=True, timeout=30, check=True).stdout
    return json.loads(out).get('result', {})


def owners(workspaces):
    return {w.get('workspace_id'): (w.get('tokens') or {}).get('owner') for w in workspaces if isinstance(w, dict)}


def short(path):
    home = str(Path.home())
    return '~' + path[len(home):] if path == home or path.startswith(home + '/') else path


def lines(agents, owner_of):
    rows = []
    for agent in agents:
        tokens = agent.get('tokens') or {}
        workspace = agent.get('workspace_id')
        fields = (agent.get('name'), agent.get('pane_id'), agent.get('agent_status'), workspace,
                  f'owner={owner_of.get(workspace) or "-"}', f'role={tokens.get("role") or "-"}', short(agent.get('cwd') or '-'))
        rows.append(' '.join(str(field or '-') for field in fields))
    return rows


def main():
    try:
        agents = herdr('agent', 'list').get('agents', [])
        try:
            owner_of = owners(herdr('workspace', 'list').get('workspaces', []))
        except (OSError, subprocess.SubprocessError, ValueError):
            owner_of = {}
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        print(f'ERROR: herdr agent list failed: {error}', file=sys.stderr)
        return 2
    print('\n'.join(lines(agents, owner_of)))
    return 0


if __name__ == '__main__':
    sys.exit(main())
