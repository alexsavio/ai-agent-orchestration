#!/usr/bin/env bash
# Opens or closes one Coordinator user-question pane.
set -euo pipefail

self=${BASH_SOURCE[0]}
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link ;; *) self=$(cd "$(dirname "$self")" && pwd)/$link ;; esac
done
root=$(cd "$(dirname "$self")" && pwd)
. "$root/coordinator/watchers/coord-lib.sh"
orch_load_config

usage() { echo "usage: ask-user-question <slug> <file> | close <slug> | hide <slug>" >&2; exit 64; }
valid_slug() { [[ $1 =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; }
questions=${ORCH_USER_QUESTIONS_DIR:-$HOME/.claude/coordinator/questions}
questions=$(cd "$(dirname "$questions")" && pwd)/$(basename "$questions")
herdr=${HERDR_BIN_PATH:-${ORCH_HERDR_BIN:-herdr}}

pane_rows() { "$herdr" pane list; }
find_pane() {
  local title=$1 prefix=${2:-}
  pane_rows | "${ORCH_PYTHON3:-python3}" -c '
import json, sys
title, prefix = sys.argv[1:]
rows = json.load(sys.stdin).get("result", {}).get("panes", [])
# pane rename sets label; the terminal title still describes the process.
def pane_title(row):
    return str(row.get("label") or row.get("terminal_title_stripped") or row.get("title") or "")

matches = [row.get("pane_id") for row in rows
           if isinstance(row, dict) and row.get("pane_id")
           and (pane_title(row).startswith(title) if prefix else pane_title(row) == title)]
print(matches[-1] if matches else "")
' "$title" "$prefix"
}

# Prints the pane an interrupted open recorded in its marker while that pane still exists. Nothing otherwise.
stale_pane() {
  pane_rows | "${ORCH_PYTHON3:-python3}" -c '
import json, sys
recorded = open(sys.argv[1]).read().split()
rows = json.load(sys.stdin).get("result", {}).get("panes", [])
print(recorded[0] if recorded and any(isinstance(row, dict) and row.get("pane_id") == recorded[0] for row in rows) else "")
' "$1"
}

action=${1:-}
# `hide <file>` opens a question that is itself called hide
[ "$action" != hide ] || [ ! -f "${2:-}" ] || valid_slug "$2" || action=open
# every action, including the pane lookup, runs under the answers lock
if [ -z "${ORCH_QUESTION_LOCKED:-}" ] && [ $# -eq 2 ]; then
  ORCH_QUESTION_LOCKED=1 ORCH_USER_QUESTIONS_DIR="$questions" exec "${ORCH_PYTHON3:-python3}" "$root/coordinator/watchers/question_lock.py" --run "$self" "$@"
fi
case $action in
  close)
    [ $# -eq 2 ] || usage
    slug=$2
    valid_slug "$slug" || { echo "invalid question slug: $slug" >&2; exit 64; }
    pane=$(find_pane "Q: $slug")
    ORCH_USER_QUESTIONS_DIR="$questions" "${ORCH_PYTHON3:-python3}" "$root/coordinator/watchers/question_lock.py" "$slug" "$root/coordinator/watchers/close-pane.sh" "$pane"
    ;;
  hide)
    [ $# -eq 2 ] || usage
    slug=$2
    valid_slug "$slug" || { echo "invalid question slug: $slug" >&2; exit 64; }
    pane=$(find_pane "Q: $slug")
    ORCH_USER_QUESTIONS_DIR="$questions" "${ORCH_PYTHON3:-python3}" "$root/coordinator/watchers/question_lock.py" --hide "$root/coordinator/watchers/close-pane.sh" "$pane"
    ;;
  *)
    [ $# -eq 2 ] || usage
    slug=$1 file=$2
    valid_slug "$slug" || { echo "invalid question slug: $slug" >&2; exit 64; }
    [ -f "$file" ] || { echo "question is not a regular file: $file" >&2; exit 66; }
    canonical="$questions/$slug.md"
    opening="$questions/$slug.opening"
    existing=$(find_pane "Q: $slug")
    [ -z "$existing" ] || { rm -f "$opening"; echo "question pane already open: $existing" >&2; exit 73; }
    [ "$(cd "$(dirname "$file")" && pwd)/$(basename "$file")" = "$canonical" ] || { echo "question file must be $canonical" >&2; exit 66; }
    if [ -s "$opening" ]; then
      stale=$(stale_pane "$opening")
      if [ -n "$stale" ]; then
        "$root/coordinator/watchers/close-pane.sh" "$stale" || { echo "cannot close pane $stale" >&2; exit 1; }
      fi
      rm -f "$opening"
    fi
    anchor=$(find_pane "Q: " prefix)
    [ -n "$anchor" ] || anchor=$(find_pane "To-do")
    if [ -z "$anchor" ]; then
      anchor=$(pane_rows | "${ORCH_PYTHON3:-python3}" -c '
import json, sys
for row in json.load(sys.stdin).get("result", {}).get("panes", []):
    tokens = row.get("tokens") or {}
    if row.get("pane_id") and "todo" in tokens:
        print(row["pane_id"])
        break
' )
    fi
    [ -n "$anchor" ] || { echo "to-do pane not found" >&2; exit 69; }
    pane=$("$herdr" pane split "$anchor" --direction down --no-focus |
      "${ORCH_PYTHON3:-python3}" -c 'import json,sys; print(json.load(sys.stdin)["result"]["pane"]["pane_id"])')
    printf '%s\n' "$pane" >"$opening"
    printf -v command '%q %q %q' "${ORCH_PYTHON3:-python3}" "$root/coordinator/question-pane.py" "$canonical"
    if ! "$herdr" pane run "$pane" "$command" || ! "$herdr" pane rename "$pane" "Q: $slug"; then
      "$root/coordinator/watchers/close-pane.sh" "$pane"
      rm -f "$opening"
      exit 1
    fi
    rm -f "$opening"
    ;;
esac
