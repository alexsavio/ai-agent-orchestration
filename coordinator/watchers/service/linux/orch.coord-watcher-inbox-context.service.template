[Unit]
Description=Coordinator watcher inbox notifier
StartLimitIntervalSec=0

[Service]
ExecStart="@ORCH_CLAUDE_DIR@/coordinator/watchers/notify-inbox.sh" "--state-dir" "@ORCH_CLAUDE_DIR@/coordinator/watchers/prod-context" "--cursor" "@ORCH_CLAUDE_DIR@/coordinator/watchers/prod-context/coordinator-deliver.cursor" "--binding" "@ORCH_CLAUDE_DIR@/coordinator/watchers/bindings/coordinator.json" "--deliver" "file" "--loop" "--configured-only" "--modes" "context" "host" "hog" "balance" "workers" "audit" "pulls" "todo"
WorkingDirectory=@ORCH_CLAUDE_DIR@/coordinator/watchers
Environment="ORCH_CONFIG=@ORCH_CONFIG@"
Environment="ORCH_PYTHON3=@ORCH_SERVICE_PYTHON@"
Environment="HERDR_BIN_PATH=@ORCH_HERDR_BIN@"
Environment=HERDR_ENV=1
Environment="HERDR_SOCKET_PATH=@ORCH_HERDR_SOCKET@"
Environment="PATH=@ORCH_PATH@"
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
