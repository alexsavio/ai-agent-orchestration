<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ORCH_CONFIG</key>
		<string>@ORCH_CONFIG@</string>
		<key>ORCH_PYTHON3</key>
		<string>@ORCH_SERVICE_PYTHON@</string>
		<key>HERDR_BIN_PATH</key>
		<string>@ORCH_HERDR_BIN@</string>
		<key>HERDR_ENV</key>
		<string>1</string>
		<key>HERDR_SOCKET_PATH</key>
		<string>@ORCH_HERDR_SOCKET@</string>
		<key>PATH</key>
		<string>@ORCH_PATH@</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>orch.coord-watcher-host</string>
	<key>ProgramArguments</key>
	<array>
		<string>@ORCH_CLAUDE_DIR@/coordinator/watchers/watcher-log-exec.sh</string>
		<string>@ORCH_CLAUDE_DIR@/coordinator/watchers/prod-context/host.stderr</string>
		<string>@ORCH_CLAUDE_DIR@/coordinator/watchers/coord-host-watch.sh</string>
		<string>--state-dir</string>
		<string>@ORCH_CLAUDE_DIR@/coordinator/watchers/prod-context</string>
		<string>--loop</string>
		<string>--interval</string>
		<string>60</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@ORCH_CLAUDE_DIR@/coordinator/watchers/prod-context/host.stderr</string>
	<key>StandardOutPath</key>
	<string>@ORCH_CLAUDE_DIR@/coordinator/watchers/prod-context/host.stdout</string>
	<key>WorkingDirectory</key>
	<string>@ORCH_CLAUDE_DIR@/coordinator/watchers</string>
</dict>
</plist>
