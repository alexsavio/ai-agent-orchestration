{
  "version": 1,
  "legacyPaths": ["app/assets/javascripts/**"],
  "legacyExtensions": [".coffee", ".js.erb"],
  "scannedPaths": ["app/**", "spec/**", "lib/**", "scripts/**"],
  "selfExempt": [
    "scripts/legacy-deletion-ratchet-rules.json",
    "scripts/legacy-deletion-ratchet.mjs",
    "scripts/legacy-deletion-ratchet.test.mjs"
  ],
  "bridgeMarker": {"pattern": "legacy-bridge\\b", "fileLevelLines": 5},
  "patterns": {
    "jquery": [
      {"id": "jquery-call", "pattern": "\\$\\(", "flags": "", "message": "jQuery call"},
      {"id": "jquery-name", "pattern": "\\bjquery\\b", "flags": "i", "message": "jQuery reference"},
      {"id": "jquery-trigger", "pattern": "\\.trigger\\(", "flags": "", "message": "jQuery trigger"}
    ],
    "ujs": [
      {"id": "ujs-remote", "pattern": "data-remote|remote: *true", "flags": "", "message": "UJS remote"},
      {"id": "ujs-lib", "pattern": "(?:jquery[_-]ujs|rails-ujs)", "flags": "", "message": "UJS library"}
    ],
    "ajax": [
      {"id": "ajax-call", "pattern": "\\$\\.ajax", "flags": "", "message": "jQuery ajax"},
      {"id": "ajax-event", "pattern": "ajax:(?<event>success|complete|error|send)", "flags": "", "message": "UJS ajax event"}
    ],
    "selectWidgets": [
      {"id": "select-widget", "pattern": "select2|legacy-select", "flags": "", "message": "legacy select widget"}
    ]
  }
}
